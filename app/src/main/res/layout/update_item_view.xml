<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/container"
    android:backgroundTint="?attr/colorSurfaceVariant"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/build_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="AfterlifeOS 20" />

            <TextView
                android:id="@+id/build_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                tools:text="18 June 2023" />

            <TextView
                android:id="@+id/build_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingTop="8sp"
                android:singleLine="true"
                tools:text="1.1 GB" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/update_action"
            android:layout_width="68dp"
            android:layout_height="48dp"
            android:src="@drawable/baseline_download_24"
            android:background="@drawable/button_first"
            android:paddingStart="4dp"
            app:tint="?attr/colorOnPrimary" />
        <ImageButton
            android:id="@+id/update_menu"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:src="@drawable/outline_more_vert_24"
            android:background="@drawable/button_second"
            android:layout_marginStart="2dp"
            app:tint="?attr/colorOnPrimary" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/progress_container"
        android:layout_marginTop="16dp">
        <ProgressBar
            android:id="@+id/progress_bar"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:progress="65" />
        <TextView
            android:id="@+id/progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/progress_bar"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textStyle="italic"
            android:visibility="invisible"
            tools:text="162 of 1.1 GB (3 minutes left)"
            tools:visibility="visible" />
        <TextView
            android:id="@+id/progress_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/progress_bar"
            android:textStyle="italic"
            android:layout_alignParentEnd="true"
            tools:text="65%" />
    </RelativeLayout>

</LinearLayout>